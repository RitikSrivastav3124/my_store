NODE_ENV=development
PORT=5000
API_PREFIX=/api

MONGO_URI=mongodb://127.0.0.1:27017/khata_ledger

JWT_ACCESS_SECRET=replace-with-a-strong-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

REPORT_BRAND_NAME=Khata Ledger
LOG_LEVEL=info
