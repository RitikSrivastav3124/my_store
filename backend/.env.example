NODE_ENV=development
PORT=port number
API_PREFIX=api prefix

MONGO_URI=mongo db Url

JWT_ACCESS_SECRET=access-secret-key
JWT_REFRESH_SECRET=refresh-secret-key
JWT_ACCESS_EXPIRES_IN=expires in seconds
REFRESH_TOKEN_EXPIRES_DAYS=expires in days

BCRYPT_SALT_ROUNDS=rounds for bcrypt hashing

CORS_ORIGIN=allowed origins for CORS
RATE_LIMIT_WINDOW_MS=window in milliseconds for rate limiting
RATE_LIMIT_MAX=maximum number of requests allowed in the window for rate limiting
AUTH_RATE_LIMIT_MAX=maximum number of requests allowed in the window for authentication rate limiting

FIREBASE_PROJECT_ID=firebase project id
FIREBASE_CLIENT_EMAIL=firebase client email
FIREBASE_PRIVATE_KEY=firebase private key

REPORT_BRAND_NAME=Khata Ledger
LOG_LEVEL=info
